{
  "name": "@skeeder/delivery-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rejeu animé d'une tournée CVRPTW sur une carte Leaflet (composant React).",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/delivery-replay.umd.cjs",
  "module": "./dist/delivery-replay.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/delivery-replay.js",
      "require": "./dist/delivery-replay.umd.cjs"
    },
    "./style.css": "./dist/delivery-replay.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.18.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vite-plugin-dts": "5.1.0"
  }
}
