# MCP Servers Configuration - Secrets Template
# ==============================================
# Copy this file to secrets.env and fill in your actual credentials
# DO NOT COMMIT secrets.env to version control - it's already in .gitignore
#
# Instructions:
# 1. Copy this file: cp .github/secrets.env.example .github/secrets.env
# 2. Fill in your actual API keys in .github/secrets.env
# 3. Never commit secrets.env - it should always be in .gitignore

# ============================================================================
# BRAVE SEARCH API
# ============================================================================
# Description: Brave Search API for web and local search capabilities
# Get from: https://api.search.brave.com/account/keys
# Provides: Web search, local business search, news search
BRAVE_API_KEY=your_brave_api_key_here

# ============================================================================
# OPENAI API - Claude Context MCP
# ============================================================================
# Description: OpenAI API Key for embeddings (used by Claude Context MCP)
# Get from: https://platform.openai.com/account/api-keys
# Provider: OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ============================================================================
# ZILLIZ CLOUD - Vector Database
# ============================================================================
# Description: Zilliz Cloud Configuration for vector embeddings storage
# Get from: https://cloud.zilliz.com/console/api-keys
# Used by: Claude Context MCP for semantic search
ZILLIZ_API_KEY=your_zilliz_api_key_here

# Zilliz Cluster URL (Public Endpoint)
# Get from: https://cloud.zilliz.com/console/cluster
# Format: https://your-cluster-id.serverless.region.cloud.zilliz.com
ZILLIZ_CLUSTER_URL=https://your-cluster-id.serverless.region.cloud.zilliz.com

# Zilliz Token (Alternative authentication method)
# Get from: https://cloud.zilliz.com/console/cluster
# Note: Use either API_KEY or Token based on your setup
MILVUS_TOKEN=your_milvus_token_here

# ============================================================================
# CONTEXT7 MCP SERVER
# ============================================================================
# Description: Context7 MCP Server for advanced context management
# Get from: Context7 Console
# API Key format: ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CONTEXT7_API_KEY=ctx7sk-your_context7_api_key_here

# ============================================================================
# MCP CONFIGURATION LOCATION
# ============================================================================
# Note: MCP Configuration is now stored in: .github/mcp.json
# The mcp.json file loads these secrets.env variables at runtime
